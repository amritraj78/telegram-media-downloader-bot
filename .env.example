# Telegram Bot Token obtained from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Port for health check server (required for Koyeb, Render, etc.)
PORT=8000

# Concurrency limits (controls memory and CPU usage)
MAX_CONCURRENT_DOWNLOADS=3

# Max file size in MB allowed to upload to Telegram (Telegram Bot API limit is 50MB)
MAX_FILE_SIZE_MB=50

# Optional: Path to cookies.txt if downloading restricted/age-gated media
# COOKIES_FILE=cookies.txt

# Log Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
